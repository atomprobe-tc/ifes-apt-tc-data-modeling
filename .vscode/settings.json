{
  "editor.rulers": [90],
  "editor.renderWhitespace": "all",
  "editor.tabSize": 4,
  "files.trimTrailingWhitespace": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  //EXPECT BELOW CODE TO REQUIRE MODIFICATIONS TO ADAPT TO YOUR VIRTUAL ENVIRONMENT CHOICE AND LOCATION !
  //either uv or virtual environment pip (the latter without or with conda)
  //when using uv where that uv .venv is two levels up, like in nomad-distro-dev deployments
  "python.defaultInterpreterPath": "${workspaceFolder}/../../.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/../../.venv/lib/python*/site-packages"],
  "python.terminal.activateEnvInCurrentTerminal": true
  //when using python virtual enviroment
  //"python.useEnvironmentsExtension": false,
  //"python.defaultInterpreterPath": "${workspaceFolder}/../.py3.12.3/bin/python",
  //"python.analysis.extraPaths": [],
}